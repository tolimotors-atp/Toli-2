# Final public HTTPS URL. Leave blank for a non-indexable local preview.
VITE_SITE_URL=
# AdSense (all optional; ads stay off unless every value below is set). See docs/ADSENSE.md.
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_SLOT_AFTER_GALLERY=
VITE_ADSENSE_SLOT_BEFORE_FOOTER=
VITE_ADS_ENABLED=
VITE_ADS_LIVE_AUTHORIZED=
# Only required if enabling the existing optional Supabase integration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional live Google reviews. Deploy supabase/functions/google-reviews (secrets GOOGLE_PLACES_API_KEY, GOOGLE_PLACE_ID);
# the site then calls it through VITE_SUPABASE_URL. Set this only to use a different endpoint.
VITE_GOOGLE_REVIEWS_URL=
